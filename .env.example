DATABASE_URL=sqlite:///./leave_system.db
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE_MINUTES=480

# 寄信設定
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=請假系統
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# 前端網址（用於產生密碼重設連結）
FRONTEND_URL=http://localhost:3000

# Cookie 安全設定（正式環境改為 true，僅允許 HTTPS 傳送 cookie）
COOKIE_SECURE=false

EMBEDDING_BASE_URL=<你 modal deploy/serve 出來的 embedding 網址>
EMBEDDING_API_KEY=<跟 leave-system-inference 那邊存的同一組 key>

# AI 對話（Gemini，從 https://aistudio.google.com/app/apikey 取得）
GEMINI_API_KEY=<你的 Gemini API key，格式為 AIzaSy 開頭>

